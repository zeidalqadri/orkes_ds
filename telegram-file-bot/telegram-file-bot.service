[Unit]
Description=Telegram File Bot — secure file transfer between Telegram and VPS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/telegram-file-bot

# Environment file – create from .env.example
EnvironmentFile=/opt/telegram-file-bot/.env

ExecStart=/opt/telegram-file-bot/.venv/bin/python /opt/telegram-file-bot/bot.py

# Auto-restart on crash
Restart=always
RestartSec=10

# Resource limits
LimitNOFILE=1024
LimitNPROC=50

# Hardening
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/bot_uploads /var/log/telegram-file-bot

[Install]
WantedBy=multi-user.target
